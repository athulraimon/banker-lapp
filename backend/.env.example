# Copy to backend/.env for local development. The real values for production
# live in the Render dashboard, not in this repo.

# Local Docker Postgres (docker compose up -d) publishes on host port 5433.
DATABASE_URL=postgres://postgres:password@localhost:5433/banker_lapp?sslmode=disable

# development | production
APP_ENV=development

# Grants an admin session with no credentials. Force-disabled in production.
ENABLE_DEV_LOGIN=false

# Must be 32+ unique characters in production or the server refuses to boot.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string-for-local-dev

# Web OAuth client ID from Google Cloud (also used as the app's webClientId).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Comma-separated Google account emails granted admin rights on login.
ADMIN_EMAILS=you@example.com

# CORS allowlist. In production set this to the PWA's origin.
ALLOWED_ORIGINS=*

DEFAULT_SEASON=2026
PORT=9000
